library(dplyr)
library(ComplexHeatmap)
library(circlize)
# Load data
dt_matrix <- readRDS("C:/Users/Juan/Documents/GitHub/deg_correlation/qc_mRNA_count_matrix.rds")
ref <- readRDS("./myeloid_reference_2023-03-12.rds")
# Define genes
genes <- c("SPP1", "CSTB", "GPNMB", "EMP1", "FABP5", "SDC2", "CD9", "CTSB", "RGCC", "CTSL", "FNIP2", "CD63", "TREM2", "C15orf48", "LPL", "ALCAM", "GSN", "LGALS3", "PLAG27", "LAMP1")
# Ensure all genes in the vector are present in the row names of dt_matrix
valid_genes <- genes[genes %in% rownames(dt_matrix)]
# Grabbing the cells we need and genes
dt_matrix <- dt_matrix[valid_genes, colnames(dt_matrix) %in% ref$meta_data$cell] %>%
as.matrix() %>%
t() %>%  # Transposing to (cell_type x gene)
as.data.frame() %>%
mutate(meta = as.character(ref$meta_data$cluster_number))
gc()
# Combine clusters into the monocyte subset
dt_matrix <- dt_matrix %>%
filter(meta %in% c("M-3", "M-4", "M-5", "M-6", "M-7", "M-8")) %>%
mutate(subset = "Monocyte")
# Determine percentage of cells within the monocyte subset expressing each gene
dt_matrix_percent <- dt_matrix %>%
group_by(subset) %>%
summarize(across(valid_genes, ~ mean(.x > 0) * 100, .names = "percent_{col}"))
# Summarize using the mean expression value for each gene within the monocyte subset
dt_matrix_mean <- dt_matrix %>%
group_by(subset) %>%
summarize(across(valid_genes, ~ mean(.x, na.rm = TRUE))) %>%
ungroup() %>%
mutate(across(where(is.numeric), ~ scale(.) %>% as.numeric()))
# Prepare the matrix for the heatmap
av <- t(dt_matrix_mean %>% as.matrix())
colnames(av) <- av[1,]
av <- av[-1,]
genes_matrix <- rownames(av)
mat_numeric <- apply(av, 2, as.numeric)
av
