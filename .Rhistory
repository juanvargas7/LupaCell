library(tidyverse)
log_norm_matrix <- log_norm[valid_genes, colnames(log_norm) %in% ref$meta_data$cell] %>%
as.matrix() %>%
t() %>%
as.data.frame() %>%
mutate(meta = as.character(ref$meta_data$cluster_number))
# Calculate the percentage of cells expressing each gene using the raw counts
dt_matrix_percent <- dt_matrix[valid_genes, colnames(dt_matrix) %in% ref$meta_data$cell] %>%
as.matrix() %>%
t() %>%
as.data.frame() %>%
mutate(meta = as.character(ref$meta_data$cluster_number)) %>%
group_by(meta) %>%
summarize(across(valid_genes, ~ mean(.x > 0) * 100, .names = "percent_{col}"))
# Summarize the log-normalized matrix using the mean, and scale
log_norm_matrix <- log_norm_matrix %>%
group_by(meta) %>%
summarize(across(everything(), mean, na.rm = TRUE)) %>%
ungroup() %>%
mutate(across(where(is.numeric), ~ scale(.) %>% as.numeric()))
# Convert the log-normalized data for heatmap plotting
av = t(log_norm_matrix %>% as.matrix())
colnames(av) = av[1,]
av = av[-1,]
genes_matrix = rownames(av)
mat_numeric <- apply(av, 2, as.numeric)
rownames(mat_numeric) = genes_matrix
mat_numeric = mat_numeric[complete.cases(mat_numeric), ]
mat_numeric[mat_numeric > 2] <- 2
mat_numeric[mat_numeric < -2] <- -2
# Prepare the percentage matrix based on the raw count data
percent_matrix <- t(dt_matrix_percent %>% as.matrix())
colnames(percent_matrix) <- percent_matrix[1,]
percent_matrix <- percent_matrix[-1,]
percent_matrix <- apply(percent_matrix, 2, as.numeric)
rownames(percent_matrix) <- genes_matrix
percent_matrix <- percent_matrix[complete.cases(percent_matrix), ]
# Function to create circles with the fill color based on the log-normalized expression value
circle_fun <- function(x, y, w, h, v, color) {
grid.rect(x = x, y = y, width = w, height = h, gp = gpar(fill = "white", col = NA))  # Background is white
grid.circle(x = x, y = y, r = unit(v / 5000, "npc"), gp = gpar(fill = color, col = NA))  # Circle fill color
}
library(circlize)
# Create heatmap using the log-normalized matrix for expression values
Heatmap(
mat_numeric,
name = "Scaled Expression",
col = colorRamp2(c(-2, 0, 2), c("blue", "white", "red")),  # Define the color gradient
cell_fun = function(j, i, x, y, width, height, fill) {
circle_fun(x, y, width, height, percent_matrix[i, j], fill)
},
show_row_names = TRUE,
show_column_names = TRUE
)
